{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "GITHUB_TOKEN"
  ],
  "globalDependencies": [
    "tsconfig.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "frontend#build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    }
  }
}
